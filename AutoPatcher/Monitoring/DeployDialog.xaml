<Window x:Class="AutoPatcher.DeployDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="배포 등록" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1B2533">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="AntiqueWhite"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="AntiqueWhite"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="대상"/>
        <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
            <RadioButton x:Name="rdTargetMain" GroupName="DeployTarget" IsChecked="True" Checked="Target_Checked"/>
            <RadioButton x:Name="rdTargetVision" GroupName="DeployTarget" Checked="Target_Checked"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="중앙 경로"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="txtTargetRoot" TextTrimming="CharacterEllipsis"/>

        <TextBlock Grid.Row="2" Text="현재 서버 버전"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="txtCurrentVersion" FontWeight="Bold"/>

        <TextBlock Grid.Row="3" Text="새 버전"/>
        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="txtNewVersion" FontSize="14" Height="26" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="4" Text="패치 폴더"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtSource" FontSize="14" Height="26" VerticalContentAlignment="Center" TextChanged="txtSource_TextChanged"/>
        <Button Grid.Row="4" Grid.Column="2" Content="찾기" Width="60" Height="26" Margin="6,0,0,0" Click="btnBrowse_Click"/>

        <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="txtSourceInfo" FontSize="12" Foreground="LightGray" TextWrapping="Wrap" Margin="0,4,0,0"/>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="등록" Width="90" Height="30" FontWeight="Bold" IsDefault="True" Click="btnOk_Click"/>
            <Button Content="취소" Width="90" Height="30" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
